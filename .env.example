# --- Telegram ---
# Токен бота от @BotFather. Бот нужен только как точка входа в Mini App
# и для проверки подписи initData.
TELEGRAM_BOT_TOKEN=123456:ABC...
# Кто может пользоваться приложением: Telegram user id через запятую.
# Узнать свой id: написать боту @userinfobot.
ALLOWED_TELEGRAM_USER_IDS=123456789
# Публичный HTTPS-адрес, где развёрнуто приложение (нужен для кнопки в боте).
PUBLIC_BASE_URL=https://example.com

# --- InSales ---
# Админка -> Настройки -> API: создать ключ, получить "Идентификатор" и "Пароль".
INSALES_SHOP=myshop.myinsales.ru
INSALES_API_KEY=xxxxxxxx
INSALES_API_PASSWORD=yyyyyyyy
# true = ничего не писать в магазин, только логировать payload (для тестов).
INSALES_DRY_RUN=true

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# --- Поиск фото в интернете (необязательно) ---
# none | google | serpapi
IMAGE_SEARCH_PROVIDER=none
# Для google: Custom Search JSON API ключ и id поисковой системы (cx) с включённым поиском картинок.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Для serpapi: ключ serpapi.com
SERPAPI_API_KEY=

# --- Разное ---
# true = не проверять подпись Telegram (ТОЛЬКО для локальной отладки в обычном браузере).
ALLOW_UNAUTHENTICATED=false
DATA_DIR=./data
